cd $(dirname $0)

VERSION=1.100.0.25101

curl -sL https://github.com/btwiuse/vscodium/releases/download/$VERSION/vscodium-reh-linux-x64-$VERSION.tar.gz | tar xz

[[ -n $RAILWAY_ENVIRONMENT ]] && {
  ufo upgrade
  ufo term &
  env RELAY=:$PORT ufo pub :1$PORT &
  ./bin/codium-server --host 0.0.0.0 --port 1$PORT --without-connection-token --start-server --install-extension saoudrizwan.claude-dev
} || {
  true
}
